{
  "name": "pos-backend",
  "version": "1.0.0",
  "description": "Backend for computer accessories store POS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate:up": "node scripts/migrate.mjs up",
    "migrate:down": "node scripts/migrate.mjs down",
    "migrate:create": "node scripts/migrate.mjs create",
    "migrate:baseline": "node scripts/migrate.mjs baseline",
    "migrate:check": "node scripts/migrate.mjs check",
    "migrate:status": "node scripts/migrate.mjs status",
    "test:migrations": "node --test scripts/migrate.test.mjs",
    "test:refund-void": "node --test src/services/sale-reversal.test.js",
    "test:product-recycle-bin": "node --test src/services/product-recycle-bin.test.js",
    "test:checkout-idempotency": "node --test src/services/checkout-fingerprint.test.js",
    "test:checkout-validation": "node --test src/services/checkout-validation.test.js",
    "test:local-network": "node --test src/lib/local-network.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "bcrypt": "^5.1.1",
    "bwip-js": "^4.11.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-pg-migrate": "9.0.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
